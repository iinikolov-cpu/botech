# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Telegram ID первого админа (обязательно). Узнать свой ID: написать боту @userinfobot
FIRST_ADMIN_ID=

# Путь к файлу базы данных (в Docker менять не нужно)
DB_PATH=/data/bot.db

# Часовой пояс для показа времени пользователям
TZ_NAME=Asia/Tashkent

# Уровень логов: debug, info, warn, error
LOG_LEVEL=info

# Сколько раз можно использовать каждый промокод. Использованием считается выполненное
# задание. Пока задание активно, код закреплён за ним и другим не выдаётся.
PROMO_MAX_USES=1

# Напоминания покупателям. Интервалы в МИНУТАХ, по возрастанию, не больше 5 значений.
# off отключает напоминания.
# Если задание отправлено, а ответа нет (минуты после отправки): 1440 = 24 часа.
REMIND_ACCEPT_MINUTES=1440,2880
# Если задание принято, а отчёта нет (минуты после принятия и после возврата на доработку).
REMIND_REPORT_MINUTES=1440,2880
# Тихие часы: в это время напоминания не отправляются, а переносятся на утро. Формат 22-9 или off.
REMIND_QUIET_HOURS=22-9
# Через сколько минут ожидания в списке заданий появляется отметка ⚠ (нет ответа, на доработке).
STALE_MINUTES=1440

# Папка и число хранимых копий базы. Копия также присылается первому админу в Telegram
# каждый день (время меняется в админке: Настройки). Менять эти значения обычно не нужно.
BACKUP_DIR=/data/backups
BACKUP_KEEP=7
